{
  "name": "klfxt-open-support",
  "version": "0.1.0",
  "private": true,
  "description": "A small, self-hosted customer support desk for local service businesses.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build && node scripts/copy-docs.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "check:public": "node scripts/check-public.mjs",
    "check": "npm run typecheck && npm run format:check && npm run check:public",
    "setup:local": "node scripts/setup-local.mjs && npm run build && npm run db:local",
    "db:local": "wrangler d1 migrations apply klfxt-open-support --local",
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "verify:local": "node scripts/verify-local.mjs",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore"
  },
  "dependencies": {
    "hono": "^4.13.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "markdown-it": "^15.0.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.156.2"
  },
  "license": "Apache-2.0"
}
